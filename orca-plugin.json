{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "dsh-web",
  "name": "DSH Web",
  "version": "0.3.0",
  "description": "Запускает DeepSeek Harness Web в tmux и подтягивает профили из $DSH_HOME/profiles.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "pluginApi": 1,
  "main": "src/worker.mjs",
  "contributes": {
    "panels": [
      {
        "id": "dsh-web",
        "title": "DSH",
        "icon": "globe",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "dsh-web.panel",
        "title": "DSH: профили",
        "when": "workspace"
      },
      {
        "id": "dsh-web.open",
        "title": "DSH: открыть (web)",
        "when": "workspace"
      },
      {
        "id": "dsh-web.openUnity",
        "title": "DSH: открыть (unity)",
        "when": "workspace"
      },
      {
        "id": "dsh-web.stop",
        "title": "DSH: остановить проект",
        "when": "workspace"
      },
      {
        "id": "dsh-web.stopAll",
        "title": "DSH: остановить все",
        "when": "workspace"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ],
    "statusBarItems": [
      {
        "id": "dsh-web",
        "text": "DSH",
        "icon": "globe",
        "tooltip": "Открыть DSH (выбрать профиль)",
        "command": "dsh-web.panel"
      }
    ],
    "settings": [
      {
        "key": "command",
        "title": "Команда запуска (web)",
        "description": "Переопределяет команду для профиля web. Остальные профили запускаются как «dsh <profile>».",
        "type": "string",
        "default": "dsh web --no-open --port 0"
      },
      {
        "key": "unityCommand",
        "title": "Команда запуска (unity)",
        "description": "Переопределяет команду для профиля unity. Остальные профили запускаются как «dsh <profile>».",
        "type": "string",
        "default": "dsh unity --no-open --port 0"
      },
      {
        "key": "stopAfterSeconds",
        "title": "Останавливать без вкладок через, сек",
        "description": "После закрытия последней вкладки DSH хост гасится через это время. 0 — никогда.",
        "type": "number",
        "default": 60
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
